DATABASE_URL=
JWT_SECRET=
# This api key is used to fetch flights between 2 airports for a given date
AVIATION_STACK_API_KEY=

# Subscribe to "AeroDataBox" api on rapid api and pass its api key here
RAPID_API_KEY=
# FlightAware API Key.
FLIGHTAWARE_API_KEY=

# ---- Flight alerts (makeshift push notifications) ----
# OneSignal app credentials for sending push notifications.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Upstash QStash token — drives the self-perpetuating 5-min poll chain.
QSTASH_TOKEN=
# Public base URL of this API (no trailing slash) that QStash calls back into,
# e.g. https://your-app.up.railway.app
ALERTS_PUBLIC_BASE_URL=
# Shared secret guarding POST /alerts/poll (sent as the x-alerts-secret header).
ALERTS_POLL_SECRET=

