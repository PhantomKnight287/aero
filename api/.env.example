DATABASE_URL=
JWT_SECRET=
# This api key is used to fetch flights between 2 airports for a given date
AVIATION_STACK_API_KEY=

# Subscribe to "AeroDataBox" api on rapid api and pass its api key here
RAPID_API_KEY=
# FlightAware API Key.
FLIGHTAWARE_API_KEY=

# ---- Flight alerts (makeshift push notifications) ----
# OneSignal app credentials for sending push notifications.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Base URL of the standalone alerts worker (the bun app in /alerts), no trailing
# slash. The API POSTs {workerUrl}/trigger when a new alert is queued.
ALERTS_WORKER_URL=http://localhost:4500
# Shared secret used in BOTH directions: guards the worker's /trigger endpoint
# and the API's POST /v1/alerts/internal/refresh (sent as x-alerts-secret).
ALERTS_SHARED_SECRET=

